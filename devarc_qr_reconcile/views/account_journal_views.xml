<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">account.journal.form.devarc.qr.reconcile</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account_reconcile_oca.view_account_journal_form" />
        <field name="arch" type="xml">
            <field name="reconcile_mode" position="after">
                <field
                    name="devarc_qr_reconcile_mode"
                    invisible="type != 'bank'"
                    groups="account.group_account_readonly"
                />
            </field>
        </field>
    </record>
</odoo>
