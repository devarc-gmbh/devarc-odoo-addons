<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="portal_login_as_log_view_list" model="ir.ui.view">
        <field name="name">devarc.portal.login.as.log.list</field>
        <field name="model">devarc.portal.login.as.log</field>
        <field name="arch" type="xml">
            <list string="Portal view-as log" create="false" delete="false" decoration-info="state == 'active'" decoration-muted="state == 'ended'">
                <field name="start_at"/>
                <field name="origin_name"/>
                <field name="target_name"/>
                <field name="partner_id" optional="show"/>
                <field name="reason" optional="hide"/>
                <field name="expires_at" optional="show"/>
                <field name="end_at" optional="show"/>
                <field name="end_reason" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="portal_login_as_log_view_form" model="ir.ui.view">
        <field name="name">devarc.portal.login.as.log.form</field>
        <field name="model">devarc.portal.login.as.log</field>
        <field name="arch" type="xml">
            <form string="Portal view-as session" create="false" delete="false">
                <header>
                    <button name="action_stop" type="object" string="Stop" class="btn-danger" groups="base.group_system" invisible="state != 'active'" confirm="The view-as session will end and its next request will log out. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title" name="title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group name="main">
                        <group name="who">
                            <field name="origin_name"/>
                            <field name="origin_user_id" invisible="not origin_user_id"/>
                            <field name="target_name"/>
                            <field name="target_user_id" invisible="not target_user_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="when">
                            <field name="start_at"/>
                            <field name="expires_at"/>
                            <field name="is_expired" invisible="not is_expired"/>
                            <field name="end_at" invisible="state != 'ended'"/>
                            <field name="end_reason" invisible="state != 'ended'"/>
                        </group>
                    </group>
                    <group name="details">
                        <field name="reason"/>
                        <field name="ip_address"/>
                        <field name="user_agent"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="portal_login_as_log_view_search" model="ir.ui.view">
        <field name="name">devarc.portal.login.as.log.search</field>
        <field name="model">devarc.portal.login.as.log</field>
        <field name="arch" type="xml">
            <search string="Portal view-as log">
                <field name="origin_name"/>
                <field name="target_name"/>
                <field name="partner_id"/>
                <field name="reason"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_ended" string="Ended" domain="[('state', '=', 'ended')]"/>
                <separator/>
                <filter name="filter_start_at" string="Started" date="start_at"/>
                <group name="group_by">
                    <filter name="group_origin" string="Viewed by" context="{'group_by': 'origin_user_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_end_reason" string="End reason" context="{'group_by': 'end_reason'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_portal_login_as_log" model="ir.actions.act_window">
        <field name="name">Portal view-as log</field>
        <field name="res_model">devarc.portal.login.as.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="portal_login_as_log_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No portal view-as sessions yet</p>
            <p>Every time staff views the customer portal as a portal user, the session is recorded here.</p>
        </field>
    </record>

    <menuitem id="menu_portal_login_as_root"
              name="Portal view-as"
              web_icon="devarc_portal_login_as,static/description/icon.png"
              groups="base.group_system,devarc_portal_login_as.group_view_my_customers"
              sequence="90"/>

    <menuitem id="menu_portal_login_as_log"
              name="Portal view-as log"
              parent="menu_portal_login_as_root"
              action="action_portal_login_as_log"
              groups="base.group_system,devarc_portal_login_as.group_view_my_customers"
              sequence="10"/>
</odoo>
