<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="portal_login_as_wizard_view_form" model="ir.ui.view">
        <field name="name">devarc.portal.login.as.wizard.form</field>
        <field name="model">devarc.portal.login.as.wizard</field>
        <field name="arch" type="xml">
            <form string="View as customer">
                <group name="main">
                    <field name="target_user_id" options="{'no_create': True}"/>
                    <field name="reason" placeholder="Why do you need to see the portal as this customer?"/>
                </group>
                <footer>
                    <button name="action_start" type="object" string="Start" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_portal_login_as_wizard" model="ir.actions.act_window">
        <field name="name">View as customer</field>
        <field name="res_model">devarc.portal.login.as.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
