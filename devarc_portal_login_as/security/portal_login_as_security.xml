<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_portal_login_as" model="ir.module.category">
        <field name="name">Portal Login As</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_view_my_customers" model="res.groups">
        <field name="name">Login As: my customers</field>
        <field name="category_id" ref="module_category_portal_login_as"/>
    </record>

    <record id="group_view_all_portal" model="res.groups">
        <field name="name">Login As: all portal users</field>
        <field name="category_id" ref="module_category_portal_login_as"/>
        <field name="implied_ids" eval="[Command.link(ref('group_view_my_customers'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="rule_log_own" model="ir.rule">
        <field name="name">Portal view-as log: own sessions</field>
        <field name="model_id" ref="model_devarc_portal_login_as_log"/>
        <field name="domain_force">[("origin_user_id", "=", user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_view_my_customers'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_log_all" model="ir.rule">
        <field name="name">Portal view-as log: all sessions</field>
        <field name="model_id" ref="model_devarc_portal_login_as_log"/>
        <field name="domain_force">[(1, "=", 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_view_all_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_log_company" model="ir.rule">
        <field name="name">Portal view-as log: multi-company</field>
        <field name="model_id" ref="model_devarc_portal_login_as_log"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
    </record>
</odoo>
