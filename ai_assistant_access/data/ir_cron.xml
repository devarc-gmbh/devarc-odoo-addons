<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ir_cron_ai_assistant_maintenance" model="ir.cron">
    <field name="name">AI assistant: expire accesses and clean up the audit log</field>
    <field name="model_id" ref="model_ai_assistant_access" />
    <field name="state">code</field>
    <field name="code">model._cron_maintenance()</field>
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active" eval="True" />
  </record>
</odoo>
